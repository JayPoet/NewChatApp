rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /rooms/{roomId}/{kind}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024 // hard ceiling; app also enforces per-type limits
        && kind in ['image', 'video', 'audio', 'document'];
      allow delete: if false;
    }
  }
}
